# =====================================================================
# NOXSOV Sovereign Enterprise Platform - Environment Configuration
# =====================================================================

# EmailJS Service Credentials
# Sign up / Log in at https://dashboard.emailjs.com/
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id_here
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id_here
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key_here

# Recipient notification email
NEXT_PUBLIC_CONTACT_TO_EMAIL=support@noxsov.com

# Supabase Database & Auth Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Public origin for partner invitation links (add /partner/activate in Supabase Auth Redirect URLs)
REFERRAL_PORTAL_URL=http://localhost:3000
