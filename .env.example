# =====================================================================
# NOXSOV Sovereign Enterprise Platform - Environment Configuration
# =====================================================================

# EmailJS Service Credentials
# Sign up / Log in at https://dashboard.emailjs.com/
# 1. Add an Email Service (e.g. Gmail, Outlook, SMTP) -> Copy "Service ID"
# 2. Create an Email Template -> Copy "Template ID"
#    Variables available:
#      - {{from_name}}      : Sender's full name
#      - {{from_email}}     : Sender's email address
#      - {{company}}        : Organization / Company name
#      - {{role}}           : Role / Department
#      - {{product}}        : Selected NOXSOV product or solution
#      - {{tier}}           : Deployment tier
#      - {{inquiry_type}}   : Technical briefing / air-gapped / pilot
#      - {{message}}        : Deployment requirements & fleet scope
#      - {{ticket_id}}      : Generated sovereign ticket reference (e.g. TKT-2026-XXXX)
#      - {{timestamp}}      : ISO timestamp of submission
# 3. Account > Security / API Keys -> Copy "Public Key"

NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id_here
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id_here
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key_here

# Optional: recipient notification email
NEXT_PUBLIC_CONTACT_TO_EMAIL=support@noxsov.com
